<mxfile host="app.diagrams.net"><diagram id="cls" name="Class Diagram"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Rough Class Diagram: Table for One Online Ordering and Inventory System" style="text;html=1;align=center;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="380" y="15" width="800" height="30" as="geometry"/></mxCell><mxCell id="Customer" value="&lt;p style=&quot;margin:0px;margin-top:6px;text-align:center;&quot;&gt;&lt;b&gt;Customer&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- customerId: int&lt;br/&gt;- name: String&lt;br/&gt;- email: String&lt;br/&gt;- phone: String&lt;br/&gt;- loyaltyPoints: int&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ createAccount()&lt;br/&gt;+ placeOrder()&lt;br/&gt;+ viewOrderHistory()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#8a7a2a;" vertex="1" parent="1"><mxGeometry x="25" y="47" width="250" height="186" as="geometry"/></mxCell><mxCell id="Order" value="&lt;p style=&quot;margin:0px;margin-top:6px;text-align:center;&quot;&gt;&lt;b&gt;Order&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- orderId: int&lt;br/&gt;- orderDate: DateTime&lt;br/&gt;- orderType: String&lt;br/&gt;- source: String&lt;br/&gt;- status: String&lt;br/&gt;- totalAmount: decimal&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ addItem()&lt;br/&gt;+ calculateTotal()&lt;br/&gt;+ updateStatus()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#8a7a2a;" vertex="1" parent="1"><mxGeometry x="440" y="48" width="250" height="203" as="geometry"/></mxCell><mxCell id="Payment" va